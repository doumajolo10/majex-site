{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "majex-site.vercel.app" }],
      "destination": "https://www.majexsites.com.br/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
