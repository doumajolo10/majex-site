{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "majex-site.vercel.app"
        }
      ],
      "destination": "https://www.majexsites.com.br/",
      "permanent": true
    },
    {
      "source": "/:caminho*",
      "has": [
        {
          "type": "host",
          "value": "majex-site.vercel.app"
        }
      ],
      "destination": "https://www.majexsites.com.br/:caminho*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
